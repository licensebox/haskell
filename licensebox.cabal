cabal-version: 2.4
name: licensebox
version: 0.1.0.0
synopsis: Native Licensebox application licensing
description: Application licensing using the Licensebox C core with typed callbacks.
category: System
maintainer: Vijai Kumar <vijai@meshing.engineer>
license: MIT
license-file: LICENSE
author: Vijai Kumar
homepage: https://meshing.engineer
build-type: Simple
library
  exposed-modules: Licensebox
  hs-source-dirs: src
  build-depends: base >=4.14 && <5, aeson >=2, bytestring, containers, text
  default-language: Haskell2010
  extra-libraries: licensebox
  ghc-options: -Wall
